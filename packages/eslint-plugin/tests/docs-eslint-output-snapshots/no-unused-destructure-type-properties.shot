Incorrect

function Button({ text }: { text: string; onClick: () => void }) {
                                          ~~~~~~~~~~~~~~~~~~~ This type declares property 'onClick', but the destructuring pattern never uses it.
  return text;
}

Incorrect

function getFirst([first]: [string, number]) {
                                    ~~~~~~ This type declares element '1', but the destructuring pattern never uses it.
  return first;
}

Incorrect

function getName({ name }: Record<'id' | 'name', string>) {
                                  ~~~~ This type declares key 'id', but the destructuring pattern never uses it.
  return name;
}

Correct

function Button({ text, onClick }: { text: string; onClick: () => void }) {
  return [text, onClick];
}

Correct

function getFirst([first]: [string]) {
  return first;
}

Correct

function getName({ name }: Record<'name', string>) {
  return name;
}
