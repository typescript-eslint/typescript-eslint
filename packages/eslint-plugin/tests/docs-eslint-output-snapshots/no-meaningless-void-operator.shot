Incorrect

void (() => {})();
~~~~~~~~~~~~~~~~~ void operator shouldn't be used on void; it should convey that a return value is being ignored

function foo() {}
void foo();
~~~~~~~~~~ void operator shouldn't be used on void; it should convey that a return value is being ignored

declare const box: { value: string };
void box;
~~~~~~~~ void operator is useless here; it should only discard a call's return value
void box.value;
~~~~~~~~~~~~~~ void operator is useless here; it should only discard a call's return value
void 1;
~~~~~~ void operator is useless here; it should only discard a call's return value

Correct

(() => {})();

function foo() {}
foo(); // nothing to discard

function bar(x: number) {
  return x * 2;
}
void bar(1);

declare const box: { value: string };
box;
box.value;

void 0;

declare const promise: Promise<number>;
void promise;
