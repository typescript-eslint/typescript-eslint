
# SCHEMA:

[
  {
    "additionalProperties": false,
    "properties": {
      "allow": {
        "description": "Identifier names for which shadowing is allowed.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "builtinGlobals": {
        "description": "Whether to report shadowing of built-in global variables.",
        "type": "boolean"
      },
      "hoist": {
        "description": "Whether to report shadowing before outer functions or variables are defined.",
        "enum": ["all", "functions", "functions-and-types", "never", "types"],
        "type": "string"
      },
      "ignoreEnumMembersOfLiteralEnums": {
        "description": "Whether to ignore members of enums whose members are all literals.",
        "type": "boolean"
      },
      "ignoreFunctionTypeParameterNameValueShadow": {
        "description": "Whether to ignore function parameters named the same as a variable.",
        "type": "boolean"
      },
      "ignoreLiteralEnumMembers": {
        "description": "Whether to ignore members of enums whose members are all literals.",
        "type": "boolean"
      },
      "ignoreOnInitialization": {
        "description": "Whether to ignore the variable initializers when the shadowed variable is presumably still uninitialized.",
        "type": "boolean"
      },
      "ignoreTypeValueShadow": {
        "description": "Whether to ignore types named the same as a variable.",
        "type": "boolean"
      }
    },
    "type": "object"
  }
]


# TYPES:

type Options = [
  {
    /** Identifier names for which shadowing is allowed. */
    allow?: string[];
    /** Whether to report shadowing of built-in global variables. */
    builtinGlobals?: boolean;
    /** Whether to report shadowing before outer functions or variables are defined. */
    hoist?:
      | 'functions'
      | 'functions-and-types'
      | 'never'
      | 'types'
      /** Whether to report shadowing before outer functions or variables are defined. */
      | 'all';
    /** Whether to ignore members of enums whose members are all literals. */
    ignoreEnumMembersOfLiteralEnums?: boolean;
    /** Whether to ignore function parameters named the same as a variable. */
    ignoreFunctionTypeParameterNameValueShadow?: boolean;
    /** Whether to ignore members of enums whose members are all literals. */
    ignoreLiteralEnumMembers?: boolean;
    /** Whether to ignore the variable initializers when the shadowed variable is presumably still uninitialized. */
    ignoreOnInitialization?: boolean;
    /** Whether to ignore types named the same as a variable. */
    ignoreTypeValueShadow?: boolean;
  },
];
